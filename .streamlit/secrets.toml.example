# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장한 뒤 값을 채우세요.
# ⚠️ secrets.toml 은 절대 GitHub에 올리지 마세요 (.gitignore 에 들어 있음).
# Streamlit Cloud 에서는 앱 설정 → Secrets 칸에 이 내용을 붙여 넣습니다.

# ---------------------------------------------------------------- Google 로그인
[auth]
# 내 컴퓨터: http://localhost:8501/oauth2callback
# 배포 후:   https://<앱이름>.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# 아무도 모르는 긴 임의 문자열 (python -c "import secrets; print(secrets.token_hex(32))")
cookie_secret = "여기에-긴-임의-문자열"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---------------------------------------------------------------- Google Sheets 저장소
[gsheets]
spreadsheet_url = "https://docs.google.com/spreadsheets/d/xxxxxxxx/edit"

# 서비스 계정 JSON 키 파일의 내용을 그대로 옮겨 적습니다.
[gsheets.service_account]
type = "service_account"
project_id = "xxxx"
private_key_id = "xxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
client_email = "bapmate@xxxx.iam.gserviceaccount.com"
client_id = "xxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/xxxx"
universe_domain = "googleapis.com"
